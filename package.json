{
  "name": "payments",
  "version": "0.1.0",
  "description": "Payments, wallets and subscriptions service",
  "author": "cubiko.co <admin@cubiko.co>",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "create-db": "ts-node ./src/orm/createDatabase.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "fixtures": "npx fixtures load ./fixtures/core ./fixtures/environments/dev --dataSource=./src/orm/write.ts --require=ts-node/register --require=tsconfig-paths/register",
    "fixtures:core": "npx fixtures load ./fixtures/core --dataSource=./src/orm/write.ts --require=ts-node/register --require=tsconfig-paths/register",
    "fixtures:dev": "npx fixtures load ./fixtures/core ./fixtures/environments/dev --dataSource=./src/orm/write.ts --require=ts-node/register --require=tsconfig-paths/register",
    "fixtures:prod": "npx fixtures load ./fixtures/core ./fixtures/environments/prod --dataSource=./src/orm/write.ts --require=ts-node/register --require=tsconfig-paths/register",
    "migration:create": "npm run typeorm -- migration:create ./migrations/$npm_config_name",
    "migration:generate": "npm run typeorm -- migration:generate ./migrations/$npm_config_name -d ./src/orm/write.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d ./src/orm/write.ts",
    "migration:run": "npm run typeorm -- migration:run -d ./src/orm/write.ts",
    "migration:show": "npm run typeorm -- migration:show -d ./src/orm/write.ts",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:stag": "node dist/src/main",
    "start:prod": "node dist/src/main",
    "test": "jest",
    "test:cov": "jest --coverage --passWithNoTests",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --detectOpenHandles --coverage",
    "test:watch": "jest --watch",
    "typeorm": "ts-node ./node_modules/typeorm/cli",
    "verify": "npm run lint && npm run test:cov"
  },
  "dependencies": {
    "@nestjs/bullmq": "^10.2.3",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/cqrs": "^10.2.7",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "bullmq": "^5.34.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.1.0",
    "pdfkit": "^0.16.0",
    "pg": "^8.16.0",
    "redis": "^4.7.0",
    "stripe": "^17.5.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.15.4",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "supertest": "^7.2.2",
    "@types/supertest": "^6.0.3",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coveragePathIgnorePatterns": [".module.ts$", ".spec.ts$", "src/main.ts"],
    "coverageDirectory": "../coverage/unit",
    "testEnvironment": "node"
  }
}
