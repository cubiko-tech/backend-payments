ENV=development
RUN=dev
ALLOWED_HOSTS=cubiko.dev,roaxai.dev,localhost

# CONTAINER
CONTAINER_IP=192.160.4.2
CONTAINER_NAME=roax-payments
CONTAINER_NUMBER=4
CONTAINER_SLUG=roax-payments

# Postgres DB (propia)
POSTGRES_HOST=192.160.1.2
POSTGRES_HOST_REPLICA=192.160.1.2
POSTGRES_DB=payments
POSTGRES_USER=cubiko
POSTGRES_PASSWORD=CHANGEME
POSTGRES_PORT=5432

# Redis (para Bull queues)
REDIS_HOST=192.160.1.5
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=CHANGEME
COOKIE_SESSION=cubiko-wt-lg

# Stripe
STRIPE_SECRET_KEY=CHANGEME
STRIPE_WEBHOOK_SECRET=CHANGEME
STRIPE_PUBLIC_KEY=CHANGEME

# MercadoPago
MP_ACCESS_TOKEN=CHANGEME
MP_WEBHOOK_SECRET=CHANGEME

# Dropi
DROPI_API_URL=https://api.dropi.co
DROPI_API_KEY=CHANGEME
DROPI_WEBHOOK_SECRET=CHANGEME

# Comunicación interna
SERVICE_AUTH=https://auth.roaxai.dev/auth/v1
SERVER_AUTH=https://auth.roaxai.dev
SERVICE_ROLES=https://app.roaxai.dev/roles
SERVICE_PROCESSES=https://app.roaxai.dev/processes
SERVICE_PLATFORM=https://app.roaxai.dev/platform
HOST_AUTH=auth.roaxai.dev:192.160.1.1
HOST_PLATFORM=app.roaxai.dev:192.160.1.1
ACCESS_SERVER=CHANGEME

# Facturación
INVOICE_PREFIX=CK
REFUND_AUTO_APPROVE_LIMIT=50000
CHECKOUT_EXPIRY_HOURS=24
MAX_PAYMENT_RETRY_COUNT=3

# Suscripciones — ciclo de vida del trial y degradación
# Días gratis del trial antes del primer cobro.
TRIAL_DAYS=15
# Duración del período de facturación recurrente (días).
BILLING_PERIOD_DAYS=30
# Plan al que se degrada la marca cuando el trial vence sin pago o se agotan los reintentos.
FREE_PLAN_SLUG=free

# ConfioPagos — pasarela de pagos COL (links de pago one-shot)
# Sandbox dev: https://api.dev.confiopagos.com/v1 — Prod: https://api.confiopagos.com/v1
# Store ID en formato ULID (no el resource name completo). Obtener vía GET /v1/stores.
CONFIO_STORE_ID=CHANGEME
CONFIO_ACCESS_TOKEN=CHANGEME
# Secreto COMPARTIDO con ConfioPagos para los webhooks, y APARTE del access token:
# es el `Bearer` que ellos mandan en cada notificacion Y la clave del checksum
# SHA-256 de la firma. Lo definimos nosotros (su doc dice "obtener O DEFINIR") y se
# acuerda con el gerente de cuenta al registrar la URL del webhook.
# Se genera con: openssl rand -hex 24
CONFIO_WEBHOOK_KEY=CHANGEME
CONFIO_API_BASE_URL=https://api.dev.confiopagos.com/v1
# Email de respaldo para cobros emitidos por el cron sin contexto de usuario.
CONFIO_FALLBACK_EMAIL=pagos@cubiko.co
# A donde vuelve el comprador despues de registrar su medio de pago en ConfioPagos.
# Es la pantalla de suscripcion de ROAX, que vive en el front de DROPI: cambia por
# ambiente (local / dev.dropi.co / app.dropi.co) y NO se compone desde DOMAIN, que
# es el dominio nuestro. Vacia = no se manda `redirectUri` y el comprador se queda
# en la pagina de ConfioPagos.
SUBSCRIPTION_RETURN_URL=

# DIAN — Facturación electrónica
# Opciones: 'siigo' | 'mock' (mock para desarrollo)
DIAN_PROVIDER=mock

# Siigo (configurar cuando se tenga cuenta)
SIIGO_API_URL=https://api.siigo.com
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=CHANGEME
SIIGO_DOCUMENT_TYPE_INVOICE=24460
SIIGO_DOCUMENT_TYPE_CREDIT_NOTE=24461
SIIGO_SELLER_ID=1
SIIGO_PAYMENT_METHOD_ID=5636
SIIGO_TAX_IVA_19_ID=1
SIIGO_TAX_IVA_5_ID=2

# Datos del emisor (Cubiko)
DIAN_ISSUER_NAME='CUBIKO S.A.S'
DIAN_ISSUER_NIT=901234567
DIAN_ISSUER_ADDRESS='Calle 100 No 10-20'
DIAN_ISSUER_CITY='Bogotá D.C.'
DIAN_ISSUER_EMAIL=facturacion@cubiko.co
DIAN_ISSUER_PHONE=+573000000000
DIAN_RESOLUTION_NUMBER=
DIAN_RESOLUTION_PREFIX=CK

# Server
DOMAIN=cubiko.dev
SERVER=payments.cubiko.dev
SSL=false
# CA del certificado para conexiones TLS a la DB (opcional, solo si SSL=true)
SSL_CA_CERT=

# --- TLS ------------------------------------------------------------------
# Desactiva validacion de certificados TLS en Node (solo dev/local).
NODE_TLS_REJECT_UNAUTHORIZED=0
