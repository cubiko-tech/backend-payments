service: backend-payments
variables:
  ENV:
    type: per_environment
    description: "Entorno de ejecucion (development, staging, production)"
    required: true
  RUN:
    type: per_environment
    description: "Modo de ejecucion (dev, prod)"
    required: true
  ALLOWED_HOSTS:
    type: per_environment
    description: "Dominios permitidos para CORS"
    required: true

  # Container
  CONTAINER_IP:
    type: per_environment
    description: "IP estatica del contenedor en la red Docker"
    required: true
  CONTAINER_NAME:
    type: fixed
    default: "roax-payments"
    description: "Nombre del contenedor Docker"
    required: true
  CONTAINER_NUMBER:
    type: fixed
    default: "4"
    description: "Numero identificador del contenedor"
    required: true
  CONTAINER_SLUG:
    type: fixed
    default: "roax-payments"
    description: "Slug del contenedor"
    required: true

  # Postgres DB
  POSTGRES_HOST:
    type: per_environment
    description: "Host de la base de datos PostgreSQL"
    required: true
  POSTGRES_HOST_REPLICA:
    type: per_environment
    description: "Host de la replica de lectura de PostgreSQL"
    required: true
  POSTGRES_DB:
    type: fixed
    default: "payments"
    description: "Nombre de la base de datos"
    required: true
  POSTGRES_USER:
    type: per_environment
    description: "Usuario de la base de datos"
    required: true
  POSTGRES_PASSWORD:
    type: auto_generate
    generate:
      length: 32
      charset: alphanumeric
    description: "Contrasena de la base de datos"
    required: true
    sensitive: true
  POSTGRES_PORT:
    type: fixed
    default: "5432"
    description: "Puerto de la base de datos"
    required: true

  # Redis
  REDIS_HOST:
    type: per_environment
    description: "Host del servidor Redis para Bull queues"
    required: true
  REDIS_PORT:
    type: fixed
    default: "6379"
    description: "Puerto del servidor Redis"
    required: true
  REDIS_PASSWORD:
    type: per_environment
    description: "Contrasena del servidor Redis (vacia en local)"
    required: false
    sensitive: true

  # JWT / Auth
  JWT_SECRET:
    type: auto_generate
    generate:
      length: 64
      charset: alphanumeric
    description: "Secreto para verificacion de tokens JWT"
    required: true
    sensitive: true
  SECRET:
    type: auto_generate
    generate:
      length: 32
      charset: alphanumeric
    description: "Secreto general de la aplicacion"
    required: true
    sensitive: true
  COOKIE_SESSION:
    type: fixed
    default: "cubiko-wt-lg"
    description: "Nombre de la cookie de sesion"
    required: true

  # Stripe
  STRIPE_SECRET_KEY:
    type: requires_admin
    description: "Clave secreta de Stripe"
    required: true
    sensitive: true
  STRIPE_WEBHOOK_SECRET:
    type: requires_admin
    description: "Secreto para validar webhooks de Stripe"
    required: true
    sensitive: true
  STRIPE_PUBLIC_KEY:
    type: requires_admin
    description: "Clave publica de Stripe"
    required: true

  # MercadoPago
  MP_ACCESS_TOKEN:
    type: requires_admin
    description: "Token de acceso de MercadoPago"
    required: true
    sensitive: true
  MP_WEBHOOK_SECRET:
    type: requires_admin
    description: "Secreto para validar webhooks de MercadoPago"
    required: true
    sensitive: true

  # Dropi
  DROPI_API_URL:
    type: per_environment
    description: "URL base de la API de Dropi"
    required: true
  DROPI_API_KEY:
    type: requires_admin
    description: "Clave de API de Dropi"
    required: true
    sensitive: true
  DROPI_WEBHOOK_SECRET:
    type: requires_admin
    description: "Secreto para validar webhooks de Dropi"
    required: true
    sensitive: true

  # Comunicacion interna
  SERVICE_AUTH:
    type: per_environment
    description: "URL del servicio de autenticacion"
    required: true
  SERVER_AUTH:
    type: per_environment
    description: "URL del servidor de autenticacion"
    required: true
  SERVICE_ROLES:
    type: per_environment
    description: "URL del servicio de roles"
    required: true
  SERVICE_PROCESSES:
    type: per_environment
    description: "URL del servicio de procesos"
    required: true
  SERVICE_PLATFORM:
    type: per_environment
    description: "URL del servicio de platform (membresía de marca)"
    required: true
  HOST_AUTH:
    type: per_environment
    description: "Mapeo host:IP del servicio auth para la red Docker"
    required: true
  HOST_PLATFORM:
    type: per_environment
    description: "Mapeo host:IP del gateway (app.*) para platform/processes/roles en la red Docker"
    required: true
  ACCESS_SERVER:
    type: auto_generate
    generate:
      length: 48
      charset: alphanumeric
    description: "Token de autenticacion entre servicios"
    required: true
    sensitive: true

  # Facturacion
  INVOICE_PREFIX:
    type: fixed
    default: "CK"
    description: "Prefijo para numeros de factura"
    required: true
  REFUND_AUTO_APPROVE_LIMIT:
    type: fixed
    default: "50000"
    description: "Limite en pesos para aprobacion automatica de reembolsos"
    required: true
  CHECKOUT_EXPIRY_HOURS:
    type: fixed
    default: "24"
    description: "Horas de vigencia del checkout antes de expirar"
    required: true
  MAX_PAYMENT_RETRY_COUNT:
    type: fixed
    default: "3"
    description: "Numero maximo de reintentos de pago"
    required: true
  TRIAL_DAYS:
    type: fixed
    default: "15"
    description: "Dias gratis del trial antes del primer cobro"
    required: true
  BILLING_PERIOD_DAYS:
    type: fixed
    default: "30"
    description: "Duracion del periodo de facturacion recurrente (dias)"
    required: true
  FREE_PLAN_SLUG:
    type: fixed
    default: "free"
    description: "Slug del plan al que se degrada la marca al vencer el trial sin pago"
    required: true

  # DIAN - Facturacion electronica
  DIAN_PROVIDER:
    type: per_environment
    description: "Proveedor de facturacion electronica (siigo | mock)"
    required: true

  # Siigo
  SIIGO_API_URL:
    type: per_environment
    description: "URL base de la API de Siigo"
    required: false
  SIIGO_USERNAME:
    type: requires_admin
    description: "Usuario de la cuenta Siigo"
    required: false
    sensitive: true
  SIIGO_ACCESS_KEY:
    type: requires_admin
    description: "Clave de acceso de Siigo"
    required: false
    sensitive: true
  SIIGO_DOCUMENT_TYPE_INVOICE:
    type: per_environment
    description: "ID del tipo de documento factura en Siigo"
    required: false
  SIIGO_DOCUMENT_TYPE_CREDIT_NOTE:
    type: per_environment
    description: "ID del tipo de documento nota credito en Siigo"
    required: false
  SIIGO_SELLER_ID:
    type: per_environment
    description: "ID del vendedor en Siigo"
    required: false
  SIIGO_PAYMENT_METHOD_ID:
    type: per_environment
    description: "ID del metodo de pago en Siigo"
    required: false
  SIIGO_TAX_IVA_19_ID:
    type: per_environment
    description: "ID del impuesto IVA 19% en Siigo"
    required: false
  SIIGO_TAX_IVA_5_ID:
    type: per_environment
    description: "ID del impuesto IVA 5% en Siigo"
    required: false

  # Datos del emisor (Cubiko)
  DIAN_ISSUER_NAME:
    type: requires_admin
    description: "Razon social del emisor para facturacion DIAN"
    required: true
  DIAN_ISSUER_NIT:
    type: requires_admin
    description: "NIT del emisor"
    required: true
    sensitive: true
  DIAN_ISSUER_ADDRESS:
    type: requires_admin
    description: "Direccion del emisor"
    required: true
  DIAN_ISSUER_CITY:
    type: requires_admin
    description: "Ciudad del emisor"
    required: true
  DIAN_ISSUER_EMAIL:
    type: requires_admin
    description: "Email de facturacion del emisor"
    required: true
  DIAN_ISSUER_PHONE:
    type: requires_admin
    description: "Telefono del emisor"
    required: true
  DIAN_RESOLUTION_NUMBER:
    type: requires_admin
    description: "Numero de resolucion DIAN"
    required: false
    sensitive: true
  DIAN_RESOLUTION_PREFIX:
    type: fixed
    default: "CK"
    description: "Prefijo de la resolucion DIAN"
    required: true

  # Server
  DOMAIN:
    type: per_environment
    description: "Dominio principal del servicio"
    required: true
  SERVER:
    type: per_environment
    description: "URL publica del servicio de pagos"
    required: true
  SSL:
    type: per_environment
    description: "Habilitar SSL (true/false)"
    required: true
  SSL_CA_CERT:
    type: per_environment
    description: "CA del certificado TLS para la conexion a la DB (opcional, solo si SSL=true)"
    required: false
    sensitive: true
  NODE_TLS_REJECT_UNAUTHORIZED:
    type: per_environment
    description: "Desactiva validacion TLS en Node (=0 solo en local/dev contra cert mkcert del gateway)"
    required: false
